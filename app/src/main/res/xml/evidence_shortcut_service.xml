<?xml version="1.0" encoding="utf-8"?>
<!--
    A button, and nothing else.

    `accessibilityEventTypes` is deliberately absent. It has no "none" flag — `typeNone` is an
    AccessibilityServiceInfo constant, not a resource value, and aapt rejects it — and omitting the
    attribute is exactly how a service subscribes to no event at all: the mask defaults to zero and
    the system delivers nothing. Together with canRetrieveWindowContent="false", this service is
    never handed a single word of what is on the screen.

    That is the reason it is reasonable to ask a blind user — who is already running TalkBack — to
    enable a second accessibility service: this one cannot read anything, it can only be pressed.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackSpoken"
    android:accessibilityFlags="flagRequestAccessibilityButton"
    android:canRetrieveWindowContent="false"
    android:description="@string/evidence_shortcut_description"
    android:notificationTimeout="0"
    android:summary="@string/evidence_shortcut_summary" />
